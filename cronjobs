<script>
document.addEventListener("DOMContentLoaded", function () {

    const toggle = document.getElementById(
        "toggleWithoutNfs"
    );

    const counter = document.getElementById(
        "visibleCounter"
    );

    const withoutNfsRows = document.querySelectorAll(
        ".cronjob-row.without-nfs"
    );

    const allRows = document.querySelectorAll(
        ".cronjob-row"
    );

    if (!toggle || !counter) {
        console.error("No se encontraron controles del filtro");
        return;
    }

    function updateFilter() {

        const showWithoutNfs = toggle.checked;

        withoutNfsRows.forEach(function (row) {
            row.classList.toggle(
                "hidden-row",
                !showWithoutNfs
            );
        });

        let visibleCount = 0;

        allRows.forEach(function (row) {
            if (!row.classList.contains("hidden-row")) {
                visibleCount++;
            }
        });

        counter.textContent =
            visibleCount +
            " visibles de " +
            allRows.length;
    }

    toggle.addEventListener("change", updateFilter);

    updateFilter();
});
</script>

