// =====================================================
// 7. EJECUCION PRINCIPAL
// =====================================================

async function main(): Promise<void> {

    // CONFIGURA TUS SERVIDORES:
    const jumpHost = "TU_JUMP_HOST";
    const targetHost = "TU_TARGET_HOST";

    console.log("====================================");
    console.log(" Kubernetes CronJobs NFS Inventory");
    console.log("====================================");

    const result = await runBashOverDoubleSsh(
        jumpHost,
        targetHost,
        bashScript
    );

    if (result.exitCode !== 0) {
        console.error(result.stderr);

        throw new Error(
            "Falló el script remoto. ExitCode: " +
            result.exitCode
        );
    }

    // El script remoto escribe logs en stderr.
    if (result.stderr.trim()) {
        console.log(result.stderr.trim());
    }

    // Convertir stdout en registros agrupados.
    const records = parseCronJobNfsOutput(
        result.stdout
    );

    // Generar y guardar el HTML LOCALMENTE.
    const html = generateCronJobHtmlReport(records);

    const reportPath = path.resolve(
        process.cwd(),
        "kubernetes-cronjobs-nfs-report.html"
    );

    fs.writeFileSync(reportPath, html, "utf8");

    const totalNfs = records.reduce(
        (sum, r) => sum + r.nfsVolumes.length,
        0
    );

    console.log("====================================");
    console.log("CronJobs:", records.length);
    console.log("Volumenes NFS:", totalNfs);
    console.log("Reporte local:", reportPath);
    console.log("====================================");
}

main().catch(error => {
    console.error("Error:", error);
    process.exitCode = 1;
});
