
import fs from "node:fs";
import path from "node:path";
import { spawn } from "node:child_process";

// =====================================================
// 1. TIPOS DE DATOS
// =====================================================

interface CommandResult {
    exitCode: number;
    stdout: string;
    stderr: string;
}

interface NfsVolume {
    volume: string;
    server: string;
    path: string;
}

interface CronJobRecord {
    namespace: string;
    cronJob: string;
    nfsVolumes: NfsVolume[];
}

// =====================================================
// 2. DOBLE SSH
// =====================================================

function runBashOverDoubleSsh(
    jumpHost: string,
    targetHost: string,
    bashScript: string
): Promise<CommandResult> {

    const maxRetries = 5;
    const retryDelayMs = 3000;

    const execute = (
        retryCount: number
    ): Promise<CommandResult> => {

        return new Promise((resolve, reject) => {

            const child = spawn("ssh", [
                "-A",
                jumpHost,
                "ssh",
                targetHost,
                "bash -s"
            ], {
                stdio: ["pipe", "pipe", "pipe"]
            });

            let stdout = "";
            let stderr = "";
            let settled = false;

            child.stdout.on("data", data => {
                stdout += data.toString();
            });

            child.stderr.on("data", data => {
                stderr += data.toString();
            });

            child.on("error", error => {
                if (!settled) {
                    settled = true;
                    reject(error);
                }
            });

            child.on("close", code => {

                if (settled) return;

                const normalizedStderr = stderr
                    .replace(/\r\n/g, "\n")
                    .trim();

                const retryableError =
                    /kex_exchange_identification: read: Connection reset by peer|Connection reset by \S+ port 2222/.test(
                        normalizedStderr
                    );

                if (
                    retryableError &&
                    retryCount < maxRetries
                ) {
                    console.warn(
                        "Reintentando SSH: " +
                        (retryCount + 1) +
                        "/" +
                        maxRetries
                    );

                    settled = true;

                    setTimeout(() => {
                        execute(retryCount + 1)
                            .then(resolve)
                            .catch(reject);
                    }, retryDelayMs);

                    return;
                }

                settled = true;

                resolve({
                    exitCode: code ?? 1,
                    stdout,
                    stderr
                });
            });

            child.stdin.on("error", () => {
                // El proceso remoto puede cerrar stdin.
                // El evento close reportará el resultado.
            });

            child.stdin.end(bashScript);
        });
    };

    return execute(0);
}

// =====================================================
// 3. SCRIPT BASH REMOTO
// =====================================================

// Este string se envía mediante SSH al Target Host.
// No se genera ningún archivo Bash físico.


const bashScript = `
#!/usr/bin/env bash
set -euo pipefail

echo "Consultando CronJobs..." >&2

cronjob_list=$(
    kubectl get cronjobs -A \\
        -o jsonpath='{range .items[*]}{.metadata.namespace}{"|"}{.metadata.name}{"\\n"}{end}'
)

CRONJOBS=()

if [[ -n "$cronjob_list" ]]; then
    mapfile -t CRONJOBS <<< "$cronjob_list"
fi

echo "CronJobs encontrados: \${#CRONJOBS[@]}" >&2

for entry in "\${CRONJOBS[@]}"; do

    namespace="\${entry%%|*}"
    cronjob="\${entry#*|}"

    echo "Procesando: $namespace / $cronjob" >&2

    if ! nfs_volumes=$(
        kubectl get cronjob "$cronjob" \\
            -n "$namespace" \\
            -o go-template='{{range .spec.jobTemplate.spec.template.spec.volumes}}{{if .nfs}}{{printf "%s\\t%s\\t%s\\n" .name .nfs.server .nfs.path}}{{end}}{{end}}'
    ); then
        echo "ERROR: $namespace/$cronjob" >&2
        exit 1
    fi

    if [[ -z "$nfs_volumes" ]]; then

        printf 'NO_NFS\\t%s\\t%s\\n' \\
            "$namespace" "$cronjob"

    else

        while IFS=$'\\t' read -r volume server nfs_path; do

            printf 'NFS_RECORD\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \\
                "$namespace" \\
                "$cronjob" \\
                "$volume" \\
                "$server" \\
                "$nfs_path"

        done <<< "$nfs_volumes"

    fi

done

echo "Consulta finalizada." >&2
`;


// =====================================================
// 4. AGRUPAR CRONJOBS Y SUS NFS
// =====================================================

function parseCronJobNfsOutput(
    stdout: string
): CronJobRecord[] {

    const records = new Map<string, CronJobRecord>();

    const lines = stdout
        .split(/\r?\n/)
        .filter(line => line.trim().length > 0);

    for (const line of lines) {

        const fields = line.split("\t");
        const type = fields[0];

        if (type !== "NFS_RECORD" && type !== "NO_NFS") {
            throw new Error(
                "Registro remoto desconocido: " + line
            );
        }

        const namespace = fields[1];
        const cronJob = fields[2];

        if (!namespace || !cronJob) {
            throw new Error(
                "Registro remoto incompleto: " + line
            );
        }

        const key = JSON.stringify([namespace, cronJob]);

        if (!records.has(key)) {
            records.set(key, {
                namespace,
                cronJob,
                nfsVolumes: []
            });
        }

        if (type === "NFS_RECORD") {

            if (
                fields.length !== 6 ||
                !fields[3] ||
                !fields[4] ||
                !fields[5]
            ) {
                throw new Error(
                    "Registro NFS inválido: " + line
                );
            }

            records.get(key)!.nfsVolumes.push({
                volume: fields[3],
                server: fields[4],
                path: fields[5]
            });
        }
    }

    return [...records.values()].sort(
        (a, b) =>
            a.namespace.localeCompare(b.namespace) ||
            a.cronJob.localeCompare(b.cronJob)
    );
}

// =====================================================
// 5. SEGURIDAD HTML
// =====================================================

function escapeHtml(value: string): string {
    return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

// =====================================================
// 6. GENERAR REPORTE HTML
// =====================================================

function generateCronJobHtmlReport(
    records: CronJobRecord[]
): string {

    const totalCronJobs = records.length;

    const cronJobsWithNfs = records.filter(
        record => record.nfsVolumes.length > 0
    ).length;

    const cronJobsWithoutNfs =
        totalCronJobs - cronJobsWithNfs;

    const totalNfsVolumes = records.reduce(
        (total, record) =>
            total + record.nfsVolumes.length,
        0
    );

    // Determina las columnas NFS necesarias.
    const maxNfsVolumes = Math.max(
        1,
        ...records.map(r => r.nfsVolumes.length)
    );

    const headers = Array.from(
        { length: maxNfsVolumes },
        (_, index) => `<th>NFS ${index + 1}</th>`
    ).join("");

    // Una sola fila por CronJob.
    const rows = records.map(record => {

        const hasNfs = record.nfsVolumes.length > 0;

        const nfsCells = Array.from(
            { length: maxNfsVolumes },
            (_, index) => {

                const nfs = record.nfsVolumes[index];

                if (!nfs) {
                    return '<td class="empty">—</td>';
                }

                return `
                    <td>
                        <div class="nfs-card">

                            <div class="volume-name">
                                ${escapeHtml(nfs.volume)}
                            </div>

                            <div class="field-label">
                                NFS Server
                            </div>

                            <div class="server">
                                ${escapeHtml(nfs.server)}
                            </div>

                            <div class="field-label">
                                NFS Path
                            </div>

                            <div class="nfs-path">
                                ${escapeHtml(nfs.path)}
                            </div>

                        </div>
                    </td>
                `;
            }
        ).join("");

        return `
            <tr class="cronjob-row ${hasNfs ? "with-nfs" : "without-nfs"}">

                <td class="namespace">
                    ${escapeHtml(record.namespace)}
                </td>

                <td class="cronjob-name">
                    ${escapeHtml(record.cronJob)}

                    ${
                        hasNfs
                            ? ""
                            : '<span class="no-nfs-label">Sin NFS</span>'
                    }
                </td>

                ${nfsCells}

            </tr>
        `;
    }).join("");

    return `
