interface NfsVolume {
    volume: string;
    server: string;
    path: string;
}

interface StatefulSetNfsRecord {
    namespace: string;
    statefulSet: string;
    nfsVolumes: NfsVolume[];
}
--------------------------
function parseNfsOutput(
    stdout: string
): StatefulSetNfsRecord[] {

    const statefulSetMap =
        new Map<string, StatefulSetNfsRecord>();

    const lines = stdout
        .split("\n")
        .map(line => line.trim())
        .filter(Boolean);

    for (const line of lines) {

        const fields = line.split("\t");

        const type = fields[0];

        if (type === "NFS_RECORD") {

            const [
                ,
                namespace,
                statefulSet,
                volume,
                server,
                nfsPath
            ] = fields;

            const key =
                `${namespace}/${statefulSet}`;

            if (!statefulSetMap.has(key)) {

                statefulSetMap.set(key, {
                    namespace,
                    statefulSet,
                    nfsVolumes: []
                });

            }

            statefulSetMap
                .get(key)!
                .nfsVolumes
                .push({
                    volume,
                    server,
                    path: nfsPath
                });

        }


        if (type === "NO_NFS") {

            const [
                ,
                namespace,
                statefulSet
            ] = fields;

            const key =
                `${namespace}/${statefulSet}`;

            if (!statefulSetMap.has(key)) {

                statefulSetMap.set(key, {
                    namespace,
                    statefulSet,
                    nfsVolumes: []
                });

            }

        }

    }

    return Array.from(
        statefulSetMap.values()
    );

}

