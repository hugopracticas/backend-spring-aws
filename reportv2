function generateHtmlReport(
    records: StatefulSetNfsRecord[]
): string {

    /*
     * Averiguamos cuál StatefulSet
     * tiene más NFS.
     *
     * Esto determina cuántas columnas
     * NFS necesitamos.
     */

    const maxNfsVolumes =
        Math.max(
            0,
            ...records.map(
                record =>
                    record.nfsVolumes.length
            )
        );


    const totalStatefulSets =
        records.length;


    const statefulSetsWithNfs =
        records.filter(
            record =>
                record.nfsVolumes.length > 0
        ).length;


    const statefulSetsWithoutNfs =
        records.filter(
            record =>
                record.nfsVolumes.length === 0
        ).length;


    const totalNfsVolumes =
        records.reduce(
            (total, record) =>
                total +
                record.nfsVolumes.length,
            0
        );


    /*
     * Creamos dinámicamente
     * NFS 1, NFS 2, NFS 3...
     */

    const nfsHeaders =
        Array.from(
            {
                length: maxNfsVolumes
            },
            (_, index) => `
                <th>
                    NFS ${index + 1}
                </th>
            `
        ).join("");


    /*
     * Generamos una sola fila
     * por StatefulSet.
     */

    const rows =
        records
            .map(record => {

                const hasNfs =
                    record.nfsVolumes.length > 0;


                /*
                 * Generamos sus celdas NFS.
                 */

                const nfsCells =
                    Array.from(
                        {
                            length:
                                maxNfsVolumes
                        },
                        (_, index) => {

                            const nfs =
                                record
                                    .nfsVolumes[index];


                            if (!nfs) {

                                return `
                                    <td
                                        class="
                                            nfs-empty
                                        "
                                    >
                                        —
                                    </td>
                                `;

                            }


                            return `
                                <td>

                                    <div
                                        class="
                                            nfs-card
                                        "
                                    >

                                        <div
                                            class="
                                                nfs-volume
                                            "
                                        >
                                            ${escapeHtml(
                                                nfs.volume
                                            )}
                                        </div>


                                        <div
                                            class="
                                                nfs-detail
                                            "
                                        >

                                            <span
                                                class="
                                                    label
                                                "
                                            >
                                                Server
                                            </span>

                                            <code
                                                class="
                                                    server
                                                "
                                            >
                                                ${escapeHtml(
                                                    nfs.server
                                                )}
                                            </code>

                                        </div>


                                        <div
                                            class="
                                                nfs-detail
                                                nfs-path
                                            "
                                        >

                                            <span
                                                class="
                                                    label
                                                "
                                            >
                                                Path
                                            </span>

                                            <code>
                                                ${escapeHtml(
                                                    nfs.path
                                                )}
                                            </code>

                                        </div>

                                    </div>

                                </td>
                            `;

                        }
                    )
                    .join("");


                return `

                    <tr
                        class="
                            statefulset-row
                            ${
                                hasNfs
                                    ? "with-nfs"
                                    : "without-nfs"
                            }
                        "
                    >

                        <td
                            class="
                                namespace-cell
                            "
                        >
                            ${escapeHtml(
                                record.namespace
                            )}
                        </td>


                        <td
                            class="
                                statefulset-cell
                            "
                        >
                            ${escapeHtml(
                                record.statefulSet
                            )}
                        </td>


                        ${nfsCells}

                    </tr>

                `;

            })
            .join("");



    return `

